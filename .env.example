# ── ENERVERA CBC — environment template (whole project) ──
# Copy to `.env` and fill in. Never commit the real `.env`.

# ── PostgreSQL (Supabase) — Layer 2 normalization knowledge base ──────────────
# Single Supabase connection string; the app derives the async (asyncpg) and sync
# (psycopg2) drivers from it automatically. Use the Supabase "Connection string"
# (Project → Settings → Database). Keep `?sslmode=require` for TLS.
#   Direct:  postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   Pooler:  postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Optional: only set to override the sync (migrations/seeds) URL explicitly.
# ALEMBIC_DATABASE_URL=

# ── OCR.space (Layer 1 extraction) ────────────────────────────────────────────
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image

# ── Neo4j (Layer 4 graph reasoning) ───────────────────────────────────────────
# Local now (neo4j://localhost:7687); switch to Aura (neo4j+s://<id>.databases.neo4j.io)
# later — no code change. NEO4J_USER is also accepted as a fallback for the username.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ── Gemini (Layer 6 LLM presentation) ─────────────────────────────────────────
# Google Gemini API key. Used by GeminiLLMClient. Keep this secret.
GEMINI_API_KEY=

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
