# ── ENERVERA CBC — environment template (whole project) ──
# Copy to `.env` and fill in. Never commit the real `.env`.

# ── PostgreSQL (Layer 2 normalization knowledge base) ─────────────────────────
# App uses the ASYNC driver; Alembic/seeding use the SYNC driver.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cbc_normalization
ALEMBIC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cbc_normalization

# ── Neo4j (Layer 4 graph reasoning) ───────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Gemini (Layer 6 LLM presentation) ─────────────────────────────────────────
# Google Gemini API key. Used by GeminiLLMClient. Keep this secret.
GEMINI_API_KEY=

# ── OCR microservice (Layer 1) ────────────────────────────────────────────────
# The backend calls this URL's /extract endpoint. On Render, point it at the
# OCR service's public URL (e.g. https://enervera-ocr.onrender.com).
OCR_SERVICE_URL=http://localhost:8001

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
