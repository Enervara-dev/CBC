# ── ENERVERA CBC/LFT/Lipid — environment template (whole project) ──
# Copy to `.env` and fill in. Never commit the real `.env` (it is gitignored).
#
#   cp .env.example .env
#
# Every variable the code reads is listed here. Only DATABASE_URL and
# CBC_API_KEYS are required to serve the analysis endpoints.

# ── PostgreSQL (Layer 2 — reference-range knowledge base) ─────────────────────
# One connection string; the app derives the async (asyncpg) and sync (psycopg2)
# drivers from it. Aurora/RDS hosts get TLS automatically (sslmode=require), so
# an explicit `?sslmode=` is optional. Seed the ranges with:
#   cd backend/src && python -m db.seed_runner
DATABASE_URL=postgresql://<user>:<password>@<cluster>.cluster-<id>.<region>.rds.amazonaws.com:5432/cbc
# Optional: only set to override the sync (Alembic / seeding) URL explicitly.
# ALEMBIC_DATABASE_URL=

# ── API authentication (required) ─────────────────────────────────────────────
# Comma-separated keys accepted in the `X-API-Key` header. Give each caller its
# own key so one can be revoked alone. Unset means the API refuses every request.
CBC_API_KEYS=<key-for-caller-a>,<key-for-caller-b>

# ── Layer 1 — OCR ─────────────────────────────────────────────────────────────
# `ocrspace` (default) or `textract`.
OCR_PROVIDER=ocrspace
# OCR.space (needed when OCR_PROVIDER=ocrspace)
OCR_SPACE_API_KEY=<key>
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
# AWS Textract (needed when OCR_PROVIDER=textract; credentials come from the
# standard AWS chain — profile, environment, or the ECS task role).
# Textract is not available in every region.
AWS_REGION=ap-south-1

# ── Neo4j (Layer 4 — optional graph reasoning) ────────────────────────────────
# The rule-based reasoner always runs; the graph only adds to it, and an outage
# degrades to rules rather than failing. NEO4J_USER is a fallback for USERNAME.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<password>
# Optional: path to the shared graph contract JSON.
# GRAPH_CONTRACT_PATH=

# ── Gemini (Layer 6 — optional patient/clinician reports) ─────────────────────
# Without a key the API still analyses; it just returns no generated reports.
# GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=<key>

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
